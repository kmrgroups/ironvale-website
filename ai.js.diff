+/* Every provider call below used to run with no timeout at all: a free-tier
+   model that hangs (they do) held the request open until Vercel's own
+   function timeout killed it, and askOpenAICompatible tried up to 6 models
+   one after another before giving up — worst case, up to 6 hangs stacked
+   back to back. This is the main reason "the AI reading the drawing" could
+   feel like it had stalled rather than just being slow. fetchWithTimeout
+   aborts a single attempt well before that and lets the loop move on to the
+   next model, and the fallback list itself is shorter (below), so a bad
+   first pick costs seconds, not the whole request. */
+const PROVIDER_TIMEOUT_MS = 25000;
+async function fetchWithTimeout(url, opts) {
+  const ctrl = new AbortController();
+  const t = setTimeout(() => ctrl.abort(), PROVIDER_TIMEOUT_MS);
+  try {
+    return await fetch(url, Object.assign({}, opts, { signal: ctrl.signal }));
+  } finally {
+    clearTimeout(t);
+  }
+}
